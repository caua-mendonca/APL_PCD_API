# Status codes
STATUS_200=Sucesso
STATUS_201=Criado com sucesso
STATUS_204=Sem conteúdo
STATUS_400=Dados inválidos
STATUS_401=Não autorizado
STATUS_403=Acesso negado
STATUS_404=Não encontrado
STATUS_409=Conflito de dados
STATUS_422=Dados não processáveis
STATUS_500=Erro interno do servidor
STATUS_503=Serviço indisponível

# Secrets para teste

{
  "name": "apl-web-pcd",
  "version": "2.4.0",
  "description": "Aplicativo para PCD na WEB",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "cross-env node --loader ts-node/esm src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:security": "jest --testPathPattern=security",
    "test:validation": "jest --testPathPattern=validation",
    "test:entities": "jest --testPathPattern=entities",
    "test:services": "jest --testPathPattern=services",
    "test:controllers": "jest --testPathPattern=controllers",
    "test:middleware": "jest --testPathPattern=middleware",
    "test:api": "jest --testPathPattern=api",
    "test:database": "jest --testPathPattern=database",
    "test:runner": "ts-node src/test/test-runner.ts",
    "test:setup": "node scripts/test-setup.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cMendoncaaa/APL-WEB-PCD.git"
  },
  "author": "Cauã Mendonça, Diego Melo, Guilherme Souza, Luis Ferracini, rodolfo Zukulo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cMendoncaaa/APL-WEB-PCD/issues"
  },
  "homepage": "https://github.com/cMendoncaaa/APL-WEB-PCD#readme",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "prompt-sync": "^4.2.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "bcrypt": "^6.0.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
